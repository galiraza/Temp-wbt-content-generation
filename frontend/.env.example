# The FastAPI backend (WBT-Content-Generation, branch wbt-web).
HUB_API_URL=http://localhost:8001

# The backend's API_KEY. Server-side only — never prefix this NEXT_PUBLIC_.
HUB_API_KEY=

# --- authentication ---------------------------------------------------------
# REQUIRED. The secret Command HQ signs SSO tickets with. Must match HQ's, or
# the /sso handoff rejects every ticket. Also signs this app's session cookie.
META_ADS_SHARED_SECRET=

# REQUIRED. The direct-login credentials for /login, when opening the app
# without going through Command HQ.
META_ADS_ADMIN_EMAIL=
META_ADS_ADMIN_PASSWORD=

# This app's own public origin. Used to build redirects — behind a reverse
# proxy the request carries an internal container hostname, so without this the
# browser gets sent there.
NEXT_PUBLIC_APP_URL=http://localhost:4000
NEXT_PUBLIC_COMMAND_HQ_URL=https://hq.webuildtrades.com
COMMAND_HQ_URL=https://hq.webuildtrades.com
