# Shared secret the frontend must send as the X-API-Key header on every request.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=...

# Comma-separated list of origins allowed to call the API — the origin of the
# frontend (the domain in the browser's address bar), not this API's own domain.
# This REPLACES the localhost dev defaults in app/config.py rather than adding to
# them. Left unset the backend allows localhost only, which is fine for `npm run
# dev` but means every real domain gets a CORS error once deployed.
CORS_ALLOW_ORIGINS=https://yourdomain.com

OPENAI_API_KEY=sk-...

# Required — always a Supabase Postgres connection string, in dev and production.
# Get this from your Supabase project: Settings > Database > Connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Pinecone vector DB — used to retrieve real client example ad angles (RAG) by industry.
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX_NAME=wbt-kb-paid-ads

# Supabase Storage — holds every uploaded logo and generated image (see app/storage.py).
# Required: without these, image uploads fail. SUPABASE_SERVICE_ROLE_KEY must be the
# service_role key (needed to upload/delete via the Storage REST API), never the anon key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_STORAGE_BUCKET=ad-angle-images

# WBT Command HQ's Client Data Export API — used to prefill the ad-angle form
# from an existing client's onboarding data. Server-side only, never exposed
# to the frontend. See docs/Client-Data-Export-API for how to obtain a key.
CLIENT_EXPORT_API_KEY=...

# Optional — n8n webhook that resolves a Fathom meeting URL into its transcript,
# used to inform logo generation. Defaults to the shared WBT n8n instance in
# app/config.py; override only if pointing at a different n8n deployment.
FATHOM_TRANSCRIPT_WEBHOOK_URL=https://n8nserver.webuildtrades.com/webhook/fathom-meeting-lookup

# Anthropic — the post/review generation agents. Required for the post module:
# without it, generation returns stub copy instead of calling the model.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5 (the n8n workflows this was ported from used claude-sonnet-4-6).
ANTHROPIC_MODEL=claude-sonnet-5

# Firecrawl — scrapes the client's public reviews page so the review agent has
# real customer reviews to work from. Without it, review generation is skipped
# and reviews_status is recorded as failed.
FIRECRAWL_API_KEY=
