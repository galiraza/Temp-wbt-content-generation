# ============================================================================
# Copy to .env and fill in. docker-compose reads this file automatically.
#
# Values marked REQUIRED have `:?` in docker-compose.yml — compose refuses to
# start without them rather than passing an empty string that fails later.
# ============================================================================

# --- database ---------------------------------------------------------------
# REQUIRED. The Supabase Postgres connection string (the pooler URI is fine).
DATABASE_URL=

# --- shared secret ----------------------------------------------------------
# REQUIRED. The frontend sends this as X-API-Key on every request. One value,
# used by both services — the frontend picks it up as HUB_API_KEY.
API_KEY=

# --- models -----------------------------------------------------------------
# REQUIRED. The agents that write the content.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional. Only the logo "from previous logo" edit path uses Gemini.
GEMINI_API_KEY=

# --- retrieval and scraping -------------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
FIRECRAWL_API_KEY=

# --- Supabase Storage -------------------------------------------------------
# REQUIRED. Every logo upload and generated image lands here.
# The SERVICE ROLE key, never the anon/public one.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ad-angle-images

# --- WBT Command HQ ---------------------------------------------------------
# The client list and the onboarding data the forms prefill from. Server-side
# only. Unset disables the prefill routes rather than breaking the app.
CLIENT_EXPORT_API_KEY=
CLIENT_EXPORT_API_URL=https://hq.webuildtrades.com/api/client-management/export

# --- deployment -------------------------------------------------------------
# Comma-separated origins allowed to call the API — the frontend's public
# domain. Empty falls back to localhost dev origins, so set it in production.
CORS_ALLOW_ORIGINS=

# Where the frontend finds the API. Leave as the compose service name unless
# the backend runs somewhere else.
HUB_API_URL=http://backend:8000

# Host ports. Change if 4000/9001 are taken.
FRONTEND_PORT=4000
BACKEND_PORT=9001
